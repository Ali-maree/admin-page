            { id: 3, username: "CyberLens",     email: "cyberlens@darknet.io", avatar: "https://picsum.photos/seed/cyber33/80/80" },
            { id: 4, username: "VoxelMaster",   email: "voxelm@grid.io",       avatar: "https://picsum.photos/seed/voxel55/80/80" },
            { id: 5, username: "HoloArtisan",   email: "holoart@fractal.io",   avatar: "https://picsum.photos/seed/holo99/80/80" },
        ];

        let content = [
            { id: 1,  userId: 1, title: "Neon Horizons",    type: "film",  status: "pending",  description: "A journey through neon-lit cityscapes of tomorrow",           thumbnail: "https://picsum.photos/seed/nh01/160/100" },
            { id: 2,  userId: 1, title: "Cyberpunk Alley",  type: "asset", status: "approved", description: "3D environment kit for dystopian street scenes",              thumbnail: "https://picsum.photos/seed/ca02/160/100" },
            { id: 3,  userId: 2, title: "Digital Rain",     type: "film",  status: "pending",  description: "Abstract visualization of data streams in motion",            thumbnail: "https://picsum.photos/seed/dr03/160/100" },
            { id: 4,  userId: 2, title: "Void Crystal",     type: "asset", status: "pending",  description: "PBR crystal formation with holographic reflections",          thumbnail: "https://picsum.photos/seed/vc04/160/100" },
            { id: 5,  userId: 3, title: "Neon Samurai",     type: "film",  status: "rejected", description: "Short film featuring a cybernetic warrior in Neo-Tokyo",      thumbnail: "https://picsum.photos/seed/ns05/160/100" },
            { id: 6,  userId: 3, title: "Mech Warrior",     type: "asset", status: "rejected", description: "Rigged mech model with damaged armor textures",               thumbnail: "https://picsum.photos/seed/mw06/160/100" },
            { id: 7,  userId: 4, title: "Quantum Grid",     type: "asset", status: "approved", description: "Procedural grid system with energy flow shaders",             thumbnail: "https://picsum.photos/seed/qg07/160/100" },
            { id: 8,  userId: 4, title: "Neural Pathway",   type: "film",  status: "approved", description: "Documentary exploring brain-computer interfaces",              thumbnail: "https://picsum.photos/seed/np08/160/100" },
            { id: 9,  userId: 5, title: "Synthwave Sunset", type: "film",  status: "pending",  description: "Retro-futuristic sunset over a digital ocean",                thumbnail: "https://picsum.photos/seed/ss09/160/100" },
            { id: 10, userId: 5, title: "Holo Fragment",    type: "asset", status: "pending",  description: "Floating holographic debris pack for sci-fi scenes",          thumbnail: "https://picsum.photos/seed/hf10/160/100" },
            { id: 11, userId: 1, title: "Pulse Engine",     type: "asset", status: "pending",  description: "Animated reactor core with particle emission effects",        thumbnail: "https://picsum.photos/seed/pe11/160/100" },
            { id: 12, userId: 4, title: "Dark Matter",      type: "film",  status: "pending",  description: "Experimental short exploring cosmic void aesthetics",          thumbnail: "https://picsum.photos/seed/dm12/160/100" },
        ];

        /* ══════════════════════════════════════
           NAVIGATION
           ══════════════════════════════════════ */
        let currentPage = 'home';

        function navigateTo(page) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            const target = document.getElementById('page-' + page);
            if (target) {
                target.classList.add('active');
                /* Re-trigger animation by forcing reflow */
                target.style.animation = 'none';
                target.offsetHeight;
                target.style.animation = '';
            }
            currentPage = page;
            window.scrollTo({ top: 0, behavior: 'smooth' });

            /* Render page content */
            switch (page) {
                case 'users':      renderUsers();      break;
                case 'films':      renderFilms();      break;
                case 'assets':     renderAssets();     break;
                case 'moderation': renderModeration(); break;
            }
        }

        /* Keyboard support for nav cards */
        document.querySelectorAll('.nav-card').forEach(card => {
            card.addEventListener('keydown', e => {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    card.click();
                }
            });
        });

        /* ══════════════════════════════════════
           RENDER: USERS
           ══════════════════════════════════════ */
        function renderUsers() {
            const el = document.getElementById('users-content');
            if (users.length === 0) {
                el.innerHTML = `<div class="empty-state"><i class="fas fa-users"></i><p>No users found</p></div>`;
                return;
            }
            let html = `<table class="data-table">
                <thead><tr>
                    <th style="width:60px;">Avatar</th>
                    <th>Username</th>
                    <th>Email</th>
                </tr></thead><tbody>`;
            users.forEach(u => {
                html += `<tr>
                    <td><img src="${u.avatar}" alt="${u.username}" class="table-avatar" loading="lazy"></td>
                    <td class="username-cell">${u.username}</td>
                    <td class="email-cell">${u.email}</td>
                </tr>`;
            });
            html += `</tbody></table>`;
            el.innerHTML = html;
        }

        /* ══════════════════════════════════════
           RENDER: FILMS
           ══════════════════════════════════════ */
        function renderFilms() {
            const el = document.getElementById('films-content');
            const films = content.filter(c => c.type === 'film');
            if (films.length === 0) {
                el.innerHTML = `<div class="glass-card empty-state"><i class="fas fa-film"></i><p>No films found</p></div>`;
                return;
            }
            let html = '';
            films.forEach(item => {
                html += `<div class="glass-card item-card">
                    <img src="${item.thumbnail}" alt="${item.title}" class="content-thumb" loading="lazy">
                    <div class="content-info">
                        <div class="content-title">${item.title}</div>
                        <div class="content-desc">${item.description}</div>
                    </div>
                    <div class="content-tags">
                        <span class="tag tag-film">Film</span>
                        <span class="tag tag-${item.status}">${cap(item.status)}</span>
                    </div>
                    <button class="action-btn btn-delete" onclick="deleteContent(${item.id},'films')" aria-label="Delete ${item.title}">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                </div>`;
            });
            el.innerHTML = html;
        }

        /* ══════════════════════════════════════
           RENDER: ASSETS
           ══════════════════════════════════════ */
        function renderAssets() {
            const el = document.getElementById('assets-content');
            const assets = content.filter(c => c.type === 'asset');
            if (assets.length === 0) {
                el.innerHTML = `<div class="glass-card empty-state"><i class="fas fa-cube"></i><p>No assets found</p></div>`;
                return;
            }
            let html = '';
            assets.forEach(item => {
                html += `<div class="glass-card item-card">
                    <img src="${item.thumbnail}" alt="${item.title}" class="content-thumb" loading="lazy">
                    <div class="content-info">
                        <div class="content-title">${item.title}</div>
                        <div class="content-desc">${item.description}</div>
                    </div>
                    <div class="content-tags">
                        <span class="tag tag-asset">Asset</span>
                        <span class="tag tag-${item.status}">${cap(item.status)}</span>
                    </div>
                    <button class="action-btn btn-delete" onclick="deleteContent(${item.id},'assets')" aria-label="Delete ${item.title}">
                        <i class="fas fa-trash-alt"></i> Delete
                    </button>
                </div>`;
            });
            el.innerHTML = html;
        }

        /* ══════════════════════════════════════
           RENDER: MODERATION
           Content grouped by user — moderation
           buttons belong to content, NOT users
           ══════════════════════════════════════ */
        function renderModeration() {
            const el = document.getElementById('moderation-content');
            let html = '';
            let hasAny = false;

            users.forEach(user => {
                const userContent = content.filter(c => c.userId === user.id);
                if (userContent.length === 0) return; /* Skip users with no content */
                hasAny = true;

                html += `<div class="user-section">
                    <div class="user-header">
                        <img src="${user.avatar}" alt="${user.username}" class="user-avatar" loading="lazy">
                        <div>
                            <div class="user-name">${user.username}</div>
                            <div class="user-email">${user.email}</div>
                        </div>
                    </div>
                    <div class="content-list">`;

                userContent.forEach(item => {
                    html += `<div class="content-row">
                        <img src="${item.thumbnail}" alt="${item.title}" class="content-thumb" loading="lazy">
                        <div class="content-info">
                            <div class="content-title">${item.title}</div>
                            <div class="content-desc">${item.description}</div>
                        </div>
                        <div class="content-tags">
                            <span class="tag tag-${item.type}">${cap(item.type)}</span>
                            <span class="tag tag-${item.status}">${cap(item.status)}</span>
                        </div>
                        <div class="content-actions">
                            <button class="action-btn btn-approve" onclick="approveContent(${item.id})" aria-label="Approve ${item.title}">Approve</button>
                            <button class="action-btn btn-reject" onclick="rejectContent(${item.id})" aria-label="Reject ${item.title}">Reject</button>
                            <button class="action-btn btn-delete" onclick="deleteContent(${item.id},'moderation')" aria-label="Delete ${item.title}">Delete</button>
                        </div>
                    </div>`;
                });

                html += `</div></div>`;
            });

            if (!hasAny) {
                html = `<div class="glass-card empty-state"><i class="fas fa-shield-halved"></i><p>No content to moderate</p></div>`;
            }

            el.innerHTML = html;
        }

        /* ══════════════════════════════════════
           ACTIONS
           ══════════════════════════════════════ */
        function approveContent(id) {
            const item = content.find(c => c.id === id);
            if (!item) return;
            item.status = 'approved';
            showToast(`"${item.title}" has been approved`, 'success');
            renderModeration();
        }

        function rejectContent(id) {
            const item = content.find(c => c.id === id);
            if (!item) return;
            item.status = 'rejected';
            showToast(`"${item.title}" has been rejected`, 'warning');
            renderModeration();
        }

        function deleteContent(id, fromPage) {
            const item = content.find(c => c.id === id);
            if (!item) return;
            const title = item.title;
            content = content.filter(c => c.id !== id);
            showToast(`"${title}" has been deleted`, 'error');

            /* Re-render whichever page triggered the delete */
            switch (fromPage) {
                case 'films':      renderFilms();      break;
                case 'assets':     renderAssets();     break;
                case 'moderation': renderModeration(); break;
            }
        }

        /* ══════════════════════════════════════
           TOAST NOTIFICATIONS
           ══════════════════════════════════════ */
        function showToast(message, type) {
            type = type || 'info';
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast toast-' + type;
            toast.textContent = message;
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('toast-exit');
                setTimeout(() => { if (toast.parentNode) toast.remove(); }, 320);
            }, 3000);
        }

        /* ══════════════════════════════════════
           UTILITY
           ══════════════════════════════════════ */
        function cap(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }
    </script>
</body>
</html>
