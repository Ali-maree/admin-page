<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #06060e;
            --card: rgba(12, 14, 30, 0.65);
            --card-hover: rgba(18, 20, 42, 0.82);
            --border: rgba(0, 240, 255, 0.10);
            --border-hover: rgba(0, 240, 255, 0.32);
            --cyan: #00f0ff;
            --pink: #ff2d78;
            --purple: #7b2fff;
            --green: #00ff88;
            --amber: #ffaa00;
            --red: #ff3366;
            --text: #dfe0f0;
            --muted: #5a5c7e;
            --surface: rgba(20, 22, 48, 0.5);
        }

        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Exo 2', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── Ambient Background ── */
        .ambient-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(150px);
            pointer-events: none;
            z-index: 0;
        }
        .orb-cyan {
            width: 650px; height: 650px;
            background: var(--cyan);
            top: -220px; right: -180px;
            opacity: 0.07;
            animation: orbDrift1 28s ease-in-out infinite;
        }
        .orb-pink {
            width: 520px; height: 520px;
            background: var(--pink);
            bottom: -160px; left: -120px;
            opacity: 0.055;
            animation: orbDrift2 34s ease-in-out infinite;
        }
        .orb-purple {
            width: 420px; height: 420px;
            background: var(--purple);
            top: 38%; left: 28%;
            opacity: 0.04;
            animation: orbDrift3 22s ease-in-out infinite;
        }
        @keyframes orbDrift1 {
            0%, 100% { transform: translate(0, 0); }
            33% { transform: translate(-90px, 70px); }
            66% { transform: translate(50px, -40px); }
        }
        @keyframes orbDrift2 {
            0%, 100% { transform: translate(0, 0); }
            33% { transform: translate(70px, -50px); }
            66% { transform: translate(-40px, 60px); }
        }
        @keyframes orbDrift3 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(60px, -70px) scale(1.12); }
        }

        /* Subtle grid overlay */
        .grid-overlay {
            position: fixed; inset: 0;
            background-image:
                linear-gradient(rgba(0, 240, 255, 0.018) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 240, 255, 0.018) 1px, transparent 1px);
            background-size: 80px 80px;
            pointer-events: none; z-index: 0;
        }

        /* ── Page System ── */
        .page {
            display: none;
            position: relative;
            z-index: 1;
            min-height: 100vh;
            padding: 2rem 2rem 4rem;
        }
        .page.active {
            display: block;
            animation: pageEnter 0.45s ease both;
        }
        @keyframes pageEnter {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* ── Glassmorphism ── */
        .glass-card {
            background: var(--card);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid var(--border);
            border-radius: 16px;
            transition: all 0.35s ease;
        }

        /* ── Navigation Cards ── */
        .nav-card {
            cursor: pointer;
            padding: 2.8rem 2rem 2.4rem;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 1rem;
            min-height: 230px;
            position: relative; overflow: hidden;
        }
        .nav-card::before {
            content: '';
            position: absolute; inset: 0;
            border-radius: 16px;
            opacity: 0;
            transition: opacity 0.45s ease;
            pointer-events: none;
        }
        .nav-card:hover::before { opacity: 1; }
        .nav-card:hover { transform: translateY(-5px); }

        .nav-card.cyan::before   { background: radial-gradient(circle at center, rgba(0,240,255,0.09), transparent 70%); }
        .nav-card.purple::before { background: radial-gradient(circle at center, rgba(123,47,255,0.09), transparent 70%); }
        .nav-card.pink::before   { background: radial-gradient(circle at center, rgba(255,45,120,0.09), transparent 70%); }
        .nav-card.green::before  { background: radial-gradient(circle at center, rgba(0,255,136,0.09), transparent 70%); }

        .nav-card.cyan:hover   { border-color: rgba(0,240,255,0.4); box-shadow: 0 0 35px rgba(0,240,255,0.14), inset 0 0 35px rgba(0,240,255,0.03); }
        .nav-card.purple:hover { border-color: rgba(123,47,255,0.4); box-shadow: 0 0 35px rgba(123,47,255,0.14), inset 0 0 35px rgba(123,47,255,0.03); }
        .nav-card.pink:hover   { border-color: rgba(255,45,120,0.4); box-shadow: 0 0 35px rgba(255,45,120,0.14), inset 0 0 35px rgba(255,45,120,0.03); }
        .nav-card.green:hover  { border-color: rgba(0,255,136,0.4); box-shadow: 0 0 35px rgba(0,255,136,0.14), inset 0 0 35px rgba(0,255,136,0.03); }

        .nav-card .icon-wrap {
            width: 68px; height: 68px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.9rem;
            border-radius: 16px;
            transition: all 0.35s ease;
        }
        .nav-card.cyan .icon-wrap   { color: var(--cyan);   background: rgba(0,240,255,0.08); }
        .nav-card.purple .icon-wrap { color: var(--purple); background: rgba(123,47,255,0.08); }
        .nav-card.pink .icon-wrap   { color: var(--pink);   background: rgba(255,45,120,0.08); }
        .nav-card.green .icon-wrap  { color: var(--green);  background: rgba(0,255,136,0.08); }

        .nav-card:hover .icon-wrap { transform: scale(1.12); }
        .nav-card .icon-wrap i { animation: iconHover 3.5s ease-in-out infinite; }
        @keyframes iconHover {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-4px); }
        }

        .nav-card .card-label {
            font-size: 1.1rem; font-weight: 700;
            letter-spacing: 0.08em; text-transform: uppercase;
        }
        .nav-card .card-desc {
            font-size: 0.78rem; color: var(--muted); text-align: center;
        }

        /* ── LIVE Badge ── */
        .live-badge {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 5px 14px; border-radius: 20px;
            background: rgba(0,255,136,0.08);
            border: 1px solid rgba(0,255,136,0.28);
            color: var(--green);
            font-size: 0.68rem; font-weight: 800;
            letter-spacing: 0.12em; text-transform: uppercase;
        }
        .live-dot {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--green);
            animation: livePulse 2s ease-in-out infinite;
        }
        @keyframes livePulse {
            0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--green); }
            50%      { opacity: 0.35; box-shadow: 0 0 12px var(--green); }
        }

        /* ── Back Button ── */
        .back-btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 9px 18px; border-radius: 10px;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--muted);
            font-size: 0.82rem; font-weight: 500;
            font-family: 'Exo 2', sans-serif;
            cursor: pointer; transition: all 0.3s ease;
        }
        .back-btn:hover {
            color: var(--cyan);
            border-color: rgba(0,240,255,0.3);
            background: rgba(0,240,255,0.05);
        }

        /* ── Tags ── */
        .tag {
            display: inline-flex; align-items: center;
            padding: 3px 11px; border-radius: 6px;
            font-size: 0.68rem; font-weight: 700;
            letter-spacing: 0.06em; text-transform: uppercase;
            white-space: nowrap;
        }
        .tag-film     { background: rgba(0,240,255,0.08);  border: 1px solid rgba(0,240,255,0.22);  color: var(--cyan); }
        .tag-asset    { background: rgba(255,45,120,0.08);  border: 1px solid rgba(255,45,120,0.22); color: var(--pink); }
        .tag-pending  { background: rgba(255,170,0,0.08);   border: 1px solid rgba(255,170,0,0.22);  color: var(--amber); }
        .tag-approved { background: rgba(0,255,136,0.08);   border: 1px solid rgba(0,255,136,0.22);  color: var(--green); }
        .tag-rejected { background: rgba(255,51,102,0.08);  border: 1px solid rgba(255,51,102,0.22); color: var(--red); }

        /* ── Action Buttons ── */
        .action-btn {
            padding: 7px 16px; border-radius: 8px;
            font-size: 0.72rem; font-weight: 700;
            font-family: 'Exo 2', sans-serif;
            cursor: pointer; transition: all 0.3s ease;
            border: 1px solid;
            text-transform: uppercase; letter-spacing: 0.06em;
            white-space: nowrap;
        }
        .btn-approve {
            background: rgba(0,255,136,0.06); border-color: rgba(0,255,136,0.22); color: var(--green);
        }
        .btn-approve:hover {
            background: rgba(0,255,136,0.18); border-color: rgba(0,255,136,0.5);
            box-shadow: 0 0 18px rgba(0,255,136,0.18);
        }
        .btn-reject {
            background: rgba(255,170,0,0.06); border-color: rgba(255,170,0,0.22); color: var(--amber);
        }
        .btn-reject:hover {
            background: rgba(255,170,0,0.18); border-color: rgba(255,170,0,0.5);
            box-shadow: 0 0 18px rgba(255,170,0,0.18);
        }
        .btn-delete {
            background: rgba(255,51,102,0.06); border-color: rgba(255,51,102,0.22); color: var(--red);
        }
        .btn-delete:hover {
            background: rgba(255,51,102,0.18); border-color: rgba(255,51,102,0.5);
            box-shadow: 0 0 18px rgba(255,51,102,0.18);
        }

        /* ── User Section (Moderation) ── */
        .user-section { margin-bottom: 1.6rem; }
        .user-header {
            display: flex; align-items: center; gap: 1rem;
            padding: 1rem 1.5rem;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px 14px 4px 4px;
            backdrop-filter: blur(24px);
        }
        .user-avatar {
            width: 46px; height: 46px; border-radius: 10px;
            object-fit: cover;
            border: 1px solid rgba(0,240,255,0.14);
            flex-shrink: 0;
        }
        .user-name { font-weight: 700; font-size: 0.95rem; }
        .user-email { font-size: 0.82rem; color: var(--muted); }

        .content-list {
            border: 1px solid var(--border);
            border-top: none;
            border-radius: 0 0 14px 14px;
            overflow: hidden;
        }
        .content-row {
            display: flex; align-items: center; gap: 1rem;
            padding: 1rem 1.5rem;
            background: rgba(8,10,24,0.55);
            border-bottom: 1px solid rgba(0,240,255,0.05);
            transition: background 0.25s ease;
        }
        .content-row:last-child { border-bottom: none; }
        .content-row:hover { background: rgba(14,16,38,0.75); }

        .content-thumb {
            width: 84px; height: 52px; border-radius: 8px;
            object-fit: cover;
            border: 1px solid rgba(0,240,255,0.08);
            flex-shrink: 0;
        }
        .content-info { flex: 1; min-width: 0; }
        .content-title { font-weight: 600; font-size: 0.92rem; margin-bottom: 3px; }
        .content-desc { font-size: 0.76rem; color: var(--muted); line-height: 1.4; }
        .content-tags { display: flex; gap: 8px; flex-shrink: 0; }
        .content-actions { display: flex; gap: 8px; flex-shrink: 0; }

        /* ── Simple Table (Users Page) ── */
        .data-table {
            width: 100%; border-collapse: separate; border-spacing: 0;
        }
        .data-table th {
            text-align: left; padding: 1rem 1.5rem;
            font-size: 0.72rem; font-weight: 800;
            letter-spacing: 0.12em; text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
            background: rgba(8,10,24,0.4);
        }
        .data-table td {
            padding: 0.9rem 1.5rem;
            border-bottom: 1px solid rgba(0,240,255,0.04);
            vertical-align: middle;
        }
        .data-table tbody tr { transition: background 0.2s ease; }
        .data-table tbody tr:hover td { background: rgba(0,240,255,0.02); }
        .table-avatar {
            width: 42px; height: 42px; border-radius: 10px;
            object-fit: cover;
            border: 1px solid rgba(0,240,255,0.1);
        }
        .username-cell { font-weight: 600; font-size: 0.92rem; }
        .email-cell { color: var(--muted); font-size: 0.88rem; }

        /* ── Content Item Card (Films / Assets pages) ── */
        .item-card {
            display: flex; align-items: center; gap: 1rem;
            padding: 1.1rem 1.5rem;
            margin-bottom: 0.65rem;
            transition: all 0.3s ease;
        }
        .item-card:hover {
            border-color: var(--border-hover);
            background: var(--card-hover);
        }

        /* ── Empty State ── */
        .empty-state {
            padding: 4rem 2rem; text-align: center;
            color: var(--muted);
        }
        .empty-state i { font-size: 2.5rem; margin-bottom: 1rem; opacity: 0.3; }
        .empty-state p { font-size: 0.9rem; }

        /* ── Toast ── */
        #toast-container {
            position: fixed; top: 1.5rem; right: 1.5rem; z-index: 200;
            display: flex; flex-direction: column; gap: 0.65rem;
            pointer-events: none;
        }
        .toast {
            padding: 12px 22px; border-radius: 10px;
            font-size: 0.84rem; font-weight: 500;
            backdrop-filter: blur(20px);
            border: 1px solid;
            animation: toastSlide 0.35s ease;
            pointer-events: auto;
            max-width: 340px;
        }
        .toast-success { background: rgba(0,255,136,0.10); border-color: rgba(0,255,136,0.28); color: var(--green); }
        .toast-warning { background: rgba(255,170,0,0.10);  border-color: rgba(255,170,0,0.28);  color: var(--amber); }
        .toast-error   { background: rgba(255,51,102,0.10);  border-color: rgba(255,51,102,0.28); color: var(--red); }
        .toast-info    { background: rgba(0,240,255,0.10);   border-color: rgba(0,240,255,0.28);  color: var(--cyan); }
        @keyframes toastSlide {
            from { opacity: 0; transform: translateX(24px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        .toast-exit { animation: toastOut 0.3s ease forwards; }
        @keyframes toastOut {
            to { opacity: 0; transform: translateX(32px) scale(0.95); }
        }

        /* ── Scrollbar ── */
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(0,240,255,0.12); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(0,240,255,0.25); }

        /* ── Focus ── */
        *:focus-visible {
            outline: 2px solid var(--cyan);
            outline-offset: 2px;
        }

        /* ── Reduced motion ── */
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }

        /* ── Responsive ── */
        @media (max-width: 900px) {
            .page { padding: 1.2rem 1rem 3rem; }
            .nav-grid { grid-template-columns: 1fr 1fr !important; }
        }
        @media (max-width: 640px) {
            .nav-grid { grid-template-columns: 1fr !important; }
            .nav-card { min-height: 180px; padding: 2rem 1.5rem; }
            .content-row { flex-wrap: wrap; }
            .content-tags { margin-top: 2px; }
            .content-actions { width: 100%; justify-content: flex-end; margin-top: 0.4rem; padding-top: 0.4rem; border-top: 1px solid rgba(0,240,255,0.05); }
            .item-card { flex-wrap: wrap; }
            .item-card .content-actions { width: 100%; justify-content: flex-end; margin-top: 0.3rem; }
            .data-table th, .data-table td { padding: 0.7rem 1rem; }
        }
    </style>
</head>
<body>

    <!-- Ambient Background -->
    <div class="ambient-orb orb-cyan"></div>
    <div class="ambient-orb orb-pink"></div>
    <div class="ambient-orb orb-purple"></div>
    <div class="grid-overlay"></div>

    <!-- Toast Container -->
    <div id="toast-container" aria-live="polite"></div>

    <!-- ═══════════ PAGE: HOME ═══════════ -->
    <section id="page-home" class="page active">
        <div class="max-w-4xl mx-auto pt-16">
            <header class="text-center mb-16">
                <div class="flex items-center justify-center gap-4 mb-3">
                    <h1 class="text-4xl font-black tracking-widest" style="letter-spacing:0.12em;">Admin Page</h1>
                    <span class="live-badge"><span class="live-dot"></span>Live</span>
                </div>
                <p class="text-sm" style="color:var(--muted); letter-spacing:0.06em;">Platform Management Console</p>
            </header>

            <nav class="nav-grid grid grid-cols-2 gap-6 max-w-2xl mx-auto" aria-label="Admin navigation">
                <div class="glass-card nav-card cyan" onclick="navigateTo('users')" role="button" tabindex="0" aria-label="Manage Users">
                    <div class="icon-wrap"><i class="fas fa-users"></i></div>
                    <span class="card-label">Users</span>
                    <span class="card-desc">Manage platform users</span>
                </div>
                <div class="glass-card nav-card purple" onclick="navigateTo('films')" role="button" tabindex="0" aria-label="Manage Films">
                    <div class="icon-wrap"><i class="fas fa-film"></i></div>
                    <span class="card-label">Films</span>
                    <span class="card-desc">Review film submissions</span>
                </div>
                <div class="glass-card nav-card pink" onclick="navigateTo('assets')" role="button" tabindex="0" aria-label="Manage Assets">
                    <div class="icon-wrap"><i class="fas fa-cube"></i></div>
                    <span class="card-label">Assets</span>
                    <span class="card-desc">Review 3D asset uploads</span>
                </div>
                <div class="glass-card nav-card green" onclick="navigateTo('moderation')" role="button" tabindex="0" aria-label="Content Moderation">
                    <div class="icon-wrap"><i class="fas fa-shield-halved"></i></div>
                    <span class="card-label">Moderation</span>
                    <span class="card-desc">Content approval workflow</span>
                </div>
            </nav>
        </div>
    </section>

    <!-- ═══════════ PAGE: USERS ═══════════ -->
    <section id="page-users" class="page">
        <div class="max-w-5xl mx-auto">
            <header class="flex items-center gap-4 mb-8">
                <button class="back-btn" onclick="navigateTo('home')" aria-label="Back to home">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <h2 class="text-2xl font-bold tracking-wide">Users</h2>
            </header>
            <div id="users-content" class="glass-card overflow-hidden"></div>
        </div>
    </section>

    <!-- ═══════════ PAGE: FILMS ═══════════ -->
    <section id="page-films" class="page">
        <div class="max-w-5xl mx-auto">
            <header class="flex items-center gap-4 mb-8">
                <button class="back-btn" onclick="navigateTo('home')" aria-label="Back to home">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <h2 class="text-2xl font-bold tracking-wide">Films</h2>
            </header>
            <div id="films-content"></div>
        </div>
    </section>

    <!-- ═══════════ PAGE: ASSETS ═══════════ -->
    <section id="page-assets" class="page">
        <div class="max-w-5xl mx-auto">
            <header class="flex items-center gap-4 mb-8">
                <button class="back-btn" onclick="navigateTo('home')" aria-label="Back to home">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <h2 class="text-2xl font-bold tracking-wide">Assets</h2>
            </header>
            <div id="assets-content"></div>
        </div>
    </section>

    <!-- ═══════════ PAGE: MODERATION ═══════════ -->
    <section id="page-moderation" class="page">
        <div class="max-w-5xl mx-auto">
            <header class="flex items-center gap-4 mb-8">
                <button class="back-btn" onclick="navigateTo('home')" aria-label="Back to home">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <h2 class="text-2xl font-bold tracking-wide">Moderation</h2>
            </header>
            <div id="moderation-content"></div>
        </div>
    </section>

    <script>
        /* ══════════════════════════════════════
           DATA — structured for easy backend sync
           ══════════════════════════════════════ */
        let users = [
            { id: 1, username: "Nova_Creator",  email: "nova@synthwave.io",    avatar: "https://picsum.photos/seed/nova42/80/80" },
